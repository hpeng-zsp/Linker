{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  },
  "Cluster": {
    "SeedNodes": [
      "127.0.0.1:5001",
      "127.0.0.1:5002",
      "127.0.0.1:5003"
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/linker.db"
  },
  "Database": {
    "Type": "Sqlite",
    "DefaultUser": "admin",
    "DefaultPassword": "admin123"
  }
}
